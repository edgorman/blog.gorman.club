moon = "2.5.5"
go = "1.26.0"          # must equal services/backend/go.mod's `go` line
node = "22"            # matches setup-node '22' in both workflows today
npm = "10.9.7"         # version bundled with Node 22 today; no prior pin existed to match
buf = "1.47.2"         # matches buf-setup-action and session-start.sh
terraform = "1.15.8"   # matches setup-terraform and every providers.tf required_version

[plugins]
# Third-party proto plugins (proto's registry/data/third-party.json), pinned to a commit
# SHA rather than a branch, so this pins what each is fetched from rather than trusting
# whatever a moving ref resolves to at install time.
# Both verify checksums on download (checksum-url is set for every platform).
buf = "https://raw.githubusercontent.com/stk0vrfl0w/proto-toml-plugins/6d304ec94bfce675a5ec210ca4d5d87c04ebb318/plugins/buf.toml"
terraform = "https://raw.githubusercontent.com/theomessin/proto-toml-plugins/b0f45e8bcc34310db680828cab62850328964996/terraform.toml"
