rules_version = '2';

// Data model assumed by these rules (enforced by the app, not by schema):
//   /users/{userId}                  - profile document, keyed by the user's auth uid
//   /blogs/{blogId}
//     ownerId: string                - uid of the user who owns the post
//     visibility: 'public' | 'private'
//     allowedUserIds: list<string>   - uids granted access when visibility is 'private'
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can look up a profile; only the owner can create or change their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public posts are readable by anyone signed in; private posts only by the owner or a
    // whitelisted uid. Only the owner can create, update, or delete their own post.
    match /blogs/{blogId} {
      allow read: if request.auth != null && (
        resource.data.visibility == 'public' ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.allowedUserIds
      );

      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
