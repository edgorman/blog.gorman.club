{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go mod download:*)",
      "Bash(gofmt:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(buf lint:*)",
      "Bash(buf format:*)",
      "Bash(buf generate:*)",
      "Bash(pants:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform -chdir=* apply:*)",
      "Bash(terraform -chdir=* destroy:*)",
      "Bash(terraform -chdir=* import:*)",
      "Bash(terraform -chdir=* state:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
