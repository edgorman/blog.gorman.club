moon = "2.6.6"
go = "1.27.4"          # must equal services/backend/go.mod's `go` line
node = "26"            # read by .github/actions/frontend-node
npm = "10.9.11"         # no prior pin existed to match
terraform = "1.17.2"   # matches setup-terraform and every providers.tf required_version

[plugins]
# Third-party proto plugin (proto's registry/data/third-party.json), pinned to a commit SHA rather
# than a branch, so this pins what it is fetched from rather than trusting whatever a moving ref
# resolves to at install time. It verifies checksums on download (checksum-url is set for every
# platform).
terraform = "https://raw.githubusercontent.com/theomessin/proto-toml-plugins/b0f45e8bcc34310db680828cab62850328964996/terraform.toml"
